# ==========================================================
# AI Resume Screening & Ranking System - Environment Config
# ==========================================================

# Google Gemini API Key (Optional: for structured LLM semantic evaluation)
# If not provided, system operates seamlessly in deterministic heuristic mode.
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: increases public API rate limits)
GITHUB_TOKEN=your_github_token_here

# LLM Model Name
LLM_MODEL=gemini-2.5-flash

# Concurrency & Timeouts
DEFAULT_CONCURRENCY=5
LLM_TIMEOUT_SECONDS=15
GITHUB_TIMEOUT_SECONDS=8
GITHUB_CACHE_TTL_SECONDS=3600
